    "async": "chain.syscall / rw.read / rw.write — отдельный TCP-сокет",
    "write_batching": "последовательные write1 батчатся по 32 KiB (staging ELF 394568 Б)",
    "stage8_pipes": "p.pipeRead/p.pipeWrite (attachPipes) — cross-pipes OK",
    "stage13_trigger": "options.triggerPayload = t1_aio_wait_race.elf (10000 B)",
    "read_cache": "prefetch 4 KiB + invalidate on write (byte scanners speed-up)",
    "bulk_read": "p.readBytes/p.writeBytes — 1 round-trip per chunk (crossPipes fast path)",
    "rtmsg2_contract": "Uint8Array(512) + .ptr/.bytes; pure {ptr,bytes} requires kernel routingSocketReply fix: copyIntoProcess(reply.bytes ?? reply)",
    "memory_spaces": "process: p.readBytes/read1-8/write1-8; kernel: rw.*, p.pipeReadBytes/p.pipeRead/pipeWrite (proto 0x08/0x09)",
