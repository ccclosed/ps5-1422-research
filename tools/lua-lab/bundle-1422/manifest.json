{
  "name": "bundle-1422",
  "purpose": "YARPE/LUA userland entry -> primitive p (read1/4/8, write1/4/8, malloc, syscall) -> jb1422 kernel chain",
  "target_firmware": "14.2x (14.20 / 14.22), userland only",
  "interface": {
    "p.read1/4/8": "int via sc.mem[addr-0x1000] slice",
    "p.write1/4/8": "bytearray slice write",
    "p.read64": "hex string (js/primitive.js contract)",
    "p.write64/read32/write32/add": "js/primitive.js contract",
    "p.malloc(size, align=1)": "utils.etc.alloc + addrof -> int addr",
    "p.syscall(num, *args)": "calls.Syscall(sc, num)(rdi..r9) -> rax",
    "p.ready()": true,
    "p.reason()": "yarpe",
    "binary_protocol": "1 byte cmd + 8 addr + 8 len/data; reply status byte + payload",
    "http_bridge": "GET/POST JSON with CORS (bridge_server.py)"
  },
  "pc_checks": {
    "primitive_selftest": "PASS (23 checks read/write/syscall over MockBackend)",
    "binary_runner_selftest": "PASS (20 operations over real TCP loopback)",
    "bridge_selftest": "PASS (12 HTTP/line contract checks)",
    "lua_probe_selftest": "PASS (Lua 5.1 compile + stub loader stages)",
    "sender_selftest": "PASS (8-byte LE framing)",
    "agent_lua_lua51_compile": "PASS",
    "run_sh": "7/7 PASS",
    "fullchain_over_tcp": "PASS: 12 stages, done=true, OK=10, DEGRADED=2, FAIL=0 (log: output/fullchain-over-tcp.log)"
  },
  "not_verified_on_pc": [
    "execution on console 14.22",
    "sc.mem against real game memory",
    "PS4 savedata encryption/import (needs JB-PS4 or Save Wizard)",
    "kernel R/W (not provided by YARPE/LUA; last public KEX 13.60)"
  ],
  "sources": [
    "https://github.com/Helloyunho/yarpe",
    "https://github.com/n0llptr/remote_lua_loader",
